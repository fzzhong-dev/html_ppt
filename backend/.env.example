# HTML_PPT 配置文件
# 复制此文件为 .env 并填入你的 API Key

# 默认使用的 LLM 提供商:
# openai | claude | zhipu | qwen | deepseek
# 若此处配置的提供商没有密钥，后端会自动尝试列表中下一个「已配置密钥」的提供商（见 /api/llm/status）
DEFAULT_PROVIDER=openai

# OpenAI / DeepSeek 共用：HTTP 超时（秒）与是否使用系统环境变量里的 HTTP(S)_PROXY
# 代理不可用导致 Connection error / ConnectTimeout 时，可设 LLM_TRUST_ENV_PROXY=false 直连
# LLM_HTTP_TIMEOUT_SECONDS=120
# LLM_CONNECT_TIMEOUT_SECONDS=45
# LLM_TRUST_ENV_PROXY=true

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# 智谱AI（仅需 Key + 模型名即可；URL 留空则 SDK 使用默认官方接口）
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4

# 通义千问
QWEN_API_KEY=
QWEN_MODEL=qwen-max
